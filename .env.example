# ═══════════════════════════════════════════════════════════════
# Universal Data Router — Environment Configuration
# AI-Powered Multi-Source File Organizer by GlowStarLabs
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
APP_NAME="Universal Data Router"
APP_VERSION=1.0.0
SECRET_KEY=your-secret-key-change-this-in-production
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ── Database ──────────────────────────────────────────────────
POSTGRES_DB=universal_data_router
POSTGRES_USER=udr
POSTGRES_PASSWORD=udr_secret
DATABASE_URL=postgresql+asyncpg://udr:udr_secret@postgres:5432/universal_data_router
DATABASE_URL_SYNC=postgresql+psycopg2://udr:udr_secret@postgres:5432/universal_data_router

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── AI / OpenRouter ──────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ── Google OAuth (Gmail + Drive) ─────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── GitHub OAuth ─────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ── Dropbox OAuth ────────────────────────────────────────────
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret

# ── Stripe Billing ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_PRO=price_your-pro-price-id
STRIPE_PRICE_ENTERPRISE=price_your-enterprise-price-id

# ── Carbon Tracking ──────────────────────────────────────────
CARBON_TRACKING_ENABLED=true

# ── JWT ──────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
